# ============================================================
# Docker 环境变量配置
# 前端拿到代码后：
# 1. 复制此文件为 .env：cp .env.docker .env
# 2. 填写下面的 DASHSCOPE_API_KEY
# 3. 运行：docker-compose up -d
# 4. 访问：http://localhost:8001/docs
# ============================================================

# 通义千问 API Key（必填）
DASHSCOPE_API_KEY=sk-xxx

# JWT 密钥（随便改个复杂字符串）
JWT_SECRET_KEY=change-me-to-random-string

# 阿里云 OSS（可选，不填就用本地存储）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_BUCKET_NAME=
