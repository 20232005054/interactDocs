            {"value": "core_dose_levels", "label": "剂量水平数"},
            {"value": "core_start_dose", "label": "起始剂量（mg）"},
            {"value": "core_max_dose", "label": "最高剂量（mg）"},
            {"value": "core_cycle_days", "label": "每治疗周期天数"},
            {"value": "core_dlt_period", "label": "剂量限制性毒性（DLT）观察期（天）"},
