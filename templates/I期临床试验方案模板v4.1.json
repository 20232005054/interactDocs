  "structure_templates": [
    {
      "title": "一、研究背景",
      "field_key": "struct_background",
      "level": 1,
      "order_index": 0,
      "paragraphs": [
        {
          "sources": [],
          "para_type": "paragraph",
          "custom_prompt": null,
          "default_prompt": "根据试验药物、适应症和研究类型，撰写研究背景。内容需包括：目标适应症的流行病学现状与疾病负担；现有治疗手段及其局限性；试验药物的作用机制、前期非临床研究或早期临床数据的简要总结；开展本项I期试验的科学依据与临床需求。全文要求800-1000字，语言严谨、专业，遵循综述风格。",
          "generation_mode": 1,
          "content_template": ""
        }
      ],
      "children": []
    },
    {
      "title": "二、研究目的",
      "field_key": "struct_objectives",
      "level": 1,
      "order_index": 1,
      "paragraphs": [
        {
          "sources": [],
          "para_type": "paragraph",
          "custom_prompt": null,
          "default_prompt": null,
          "generation_mode": 2,
          "content_template": "本研究的主要目的是评价试验药物在目标受试者人群中的安全性和耐受性，确定剂量限制毒性（DLT）及最大耐受剂量（MTD），为后续临床试验的推荐剂量提供依据。次要目的包括：1）评价试验药物的药代动力学（PK）特征，计算主要PK参数如峰浓度（Cmax）、药时曲线下面积（AUC）、半衰期（t1/2）、表观分布容积（Vd/F）及清除率（CL/F）等；2）初步观察试验药物的药效学效应或抗肿瘤/治疗活性（如适用），通过生物标志物或影像学评估初步疗效信号；3）探索药物暴露与效应、毒性之间的关系，为剂量选择提供PK/PD模型支持。对于食物影响或药物相互作用子研究，还将评估进食或合并用药对PK参数的影响。以上目的将依据研究类型在具体方案中进一步细化。"
        }
      ],
      "children": []
    },
    {
      "title": "三、总体研究设计",
      "field_key": "struct_study_design",
      "level": 1,
      "order_index": 2,
      "paragraphs": [
        {
          "sources": [],
