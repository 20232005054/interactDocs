# ============================================================
# 告警系统配置示例
# ============================================================
# 将此文件复制为 .env 并填入实际配置

# ------------------------------------------------------------
# 邮件告警配置
# ------------------------------------------------------------
# 是否启用邮件告警（true/false）
ALERT_EMAIL_ENABLED=false

# SMTP 服务器配置
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587

# 发件人认证信息
ALERT_EMAIL_USER=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password

# 发件人和收件人地址
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=admin@yourdomain.com

# ------------------------------------------------------------
# Webhook 告警配置（钉钉、Slack、企业微信）
# ------------------------------------------------------------
# 是否启用 Webhook 告警（true/false）
ALERT_WEBHOOK_ENABLED=false

# Webhook URL
# 钉钉示例：https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# Slack示例：https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# 企业微信示例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
ALERT_WEBHOOK_URL=

# Webhook 类型（dingtalk, slack, wecom, generic）
ALERT_WEBHOOK_TYPE=dingtalk

# ------------------------------------------------------------
# 告警级别说明
# ------------------------------------------------------------
# INFO      - 信息级别，仅记录日志
# WARNING   - 警告级别，发送 Webhook 通知
# ERROR     - 错误级别，发送邮件 + Webhook 通知
# CRITICAL  - 严重级别，发送邮件 + Webhook 通知

# ------------------------------------------------------------
# 钉钉机器人配置步骤
# ------------------------------------------------------------
# 1. 在钉钉群中添加自定义机器人
# 2. 安全设置选择"自定义关键词"，添加关键词：告警
# 3. 复制 Webhook URL 到 ALERT_WEBHOOK_URL
# 4. 设置 ALERT_WEBHOOK_TYPE=dingtalk

# ------------------------------------------------------------
# Slack Webhook 配置步骤
# ------------------------------------------------------------
# 1. 访问 https://api.slack.com/apps
# 2. 创建新应用，启用 Incoming Webhooks
# 3. 添加 Webhook 到工作区
# 4. 复制 Webhook URL 到 ALERT_WEBHOOK_URL
# 5. 设置 ALERT_WEBHOOK_TYPE=slack

# ------------------------------------------------------------
# 企业微信机器人配置步骤
# ------------------------------------------------------------
# 1. 在企业微信群中添加群机器人
# 2. 复制 Webhook URL 到 ALERT_WEBHOOK_URL
# 3. 设置 ALERT_WEBHOOK_TYPE=wecom

# ------------------------------------------------------------
# Gmail SMTP 配置说明
# ------------------------------------------------------------
# 1. 启用两步验证：https://myaccount.google.com/security
# 2. 生成应用专用密码：https://myaccount.google.com/apppasswords
# 3. 使用应用专用密码作为 ALERT_EMAIL_PASSWORD
